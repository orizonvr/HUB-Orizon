# =============================================================
# OrizonVR | Pipeline — Variáveis de ambiente (modelo)
# Copie este arquivo para `.env` e preencha os valores reais.
# O `.env` real NUNCA deve ser versionado (está no .gitignore).
# =============================================================

# -------------------------------------------------------------
# Supabase — SERVIDOR (runtime). Lidas via process.env no servidor.
# -------------------------------------------------------------
SUPABASE_URL="https://SEU_PROJECT_ID.supabase.co"
# Chave pública (anon). Usada pelo middleware de autenticação no servidor.
SUPABASE_PUBLISHABLE_KEY="ey..."
# Chave service_role (ADMIN — bypassa RLS). SEGREDO CRÍTICO.
# Só existe no servidor. NUNCA expor ao cliente nem commitar.
SUPABASE_SERVICE_ROLE_KEY="ey..."

# -------------------------------------------------------------
# Supabase — CLIENTE (BUILD-TIME). Prefixo VITE_ → embutidas no
# bundle do navegador durante `vite build`. Precisam estar
# presentes no momento do BUILD (ex.: no GitHub Actions), não
# apenas no runtime da Azure.
# -------------------------------------------------------------
VITE_SUPABASE_URL="https://SEU_PROJECT_ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="ey..."
VITE_SUPABASE_PROJECT_ID="SEU_PROJECT_ID"

# -------------------------------------------------------------
# Email (Resend) — envio direto pela API oficial (sem gateway Lovable)
# -------------------------------------------------------------
# Crie em https://resend.com/api-keys
RESEND_API_KEY="re_..."
# Remetente verificado no Resend (domínio próprio recomendado em produção)
EMAIL_FROM="OrizonVR Pipeline <pipeline@seu-dominio.com.br>"

# -------------------------------------------------------------
# App / Cron
# -------------------------------------------------------------
# URL pública do app (usada em links de email e como destino do cron).
# Na Azure: https://<seu-app>.azurewebsites.net (ou domínio custom).
APP_BASE_URL="https://orizon-pipeline.exemplo.com.br"
# Segredo para autenticar o cron diário (/api/public/hooks/notify-tarefas).
# Gere um valor forte e aleatório (ex.: openssl rand -hex 32).
CRON_SECRET="troque-por-um-segredo-forte-aleatorio"

# -------------------------------------------------------------
# IA (Anthropic) — geração de briefing do comitê. SERVIDOR APENAS.
# Nunca prefixar com VITE_ — a chave NÃO pode ir ao cliente.
# Na Azure: configurar no App Service. No Lovable: adicionar como secret.
# -------------------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-4-6"

# -------------------------------------------------------------
# Build target (NÃO definir no Lovable). Definir apenas no pipeline
# GitHub Actions → Azure para gerar o servidor Node:
#   BUILD_TARGET=node
# Com isso, `npm run build:node` gera o servidor em dist/server/index.mjs
# (rodável com `npm start`). Sem essa variável, o build mantém o
# comportamento padrão da Lovable (Nitro preset cloudflare-module).
# -------------------------------------------------------------
# BUILD_TARGET="node"
